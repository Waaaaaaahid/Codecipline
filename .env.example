# ============================================================
# DevMarket — Environment Variables
# ============================================================
# Copy this file to .env.local and fill in every value.
# NEVER commit .env.local to version control.
# ============================================================

# ----------------------------------------------------------
# App
# ----------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Production: https://yourdomain.com

# ----------------------------------------------------------
# MongoDB
# ----------------------------------------------------------
# Get a free cluster at https://cloud.mongodb.com
MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/devmarket?retryWrites=true&w=majority

# ----------------------------------------------------------
# JWT (Admin Authentication)
# ----------------------------------------------------------
# Generate a strong secret: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-secret-string

# ----------------------------------------------------------
# Razorpay
# ----------------------------------------------------------
# Dashboard → Settings → API Keys
# Key ID is safe to expose to the browser (NEXT_PUBLIC_)
# Key Secret MUST stay server-side only
RAZORPAY_KEY_ID=rzp_test_XXXXXXXXXXXXXXXX
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
# Use rzp_live_* keys in production

# ----------------------------------------------------------
# Admin Seed Script (optional overrides)
# ----------------------------------------------------------
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Admin

# ----------------------------------------------------------
# Contact Form — Email (optional)
# ----------------------------------------------------------
# If you want contact form emails, integrate Resend / Nodemailer
# RESEND_API_KEY=re_xxxxxxxxxxxx
# CONTACT_EMAIL=hello@devmarket.dev
